# Copy this file to .streamlit/secrets.toml (which is gitignored) for local development.
# On Streamlit Community Cloud, set these instead in your app's Settings -> Secrets.

ANTHROPIC_API_KEY = "sk-ant-..."

# Optional: require this password before the app loads. Useful if you deploy publicly
# and want to stop random visitors from using your AI budget or seeing your data.
# Leave unset (or delete this line) to leave the app open, e.g. for solo/local use.
# APP_PASSWORD = "choose-something-only-you-know"
